generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum SkillCategory {
  FRONTEND
  BACKEND
  DATABASE
  TOOLS
  OTHER
}

// 1. Admin User
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 2. Profile
model Profile {
  id          String   @id @default(cuid())
  fullName    String   @default("Dzulfikar Tadah")
  role        String   @default("Fullstack Developer")
  headline    String   @db.Text
  biography   String   @db.Text
  location    String?
  avatarUrl   String?
  cvUrl       String?
  githubUrl   String?
  linkedinUrl String?
  emailPublic String?
  updatedAt   DateTime @updatedAt
}

// 3. Project & Relasi
model Project {
  id           String              @id @default(cuid())
  title        String
  slug         String              @unique
  summary      String              @db.Text
  description  String              @db.Text
  category     String
  thumbnail    String?
  liveUrl      String?
  repoUrl      String?
  year         Int
  featured     Boolean             @default(false)
  status       ContentStatus       @default(DRAFT)
  technologies ProjectTechnology[]
  screenshots  ProjectScreenshot[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model ProjectTechnology {
  id        String  @id @default(cuid())
  name      String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectScreenshot {
  id        String  @id @default(cuid())
  imageUrl  String
  caption   String?
  sortOrder Int     @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// 4. Skill
model Skill {
  id        String        @id @default(cuid())
  name      String
  category  SkillCategory @default(FRONTEND)
  level     String?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// 5. Experience
model Experience {
  id           String    @id @default(cuid())
  title        String
  organization String
  description  String    @db.Text
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// 6. Article (Journal)
model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String        @db.Text
  content     String        @db.Text
  coverUrl    String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// 7. Contact Message
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// 8. Media
model Media {
  id        String   @id @default(cuid())
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int
  createdAt DateTime @default(now())
}